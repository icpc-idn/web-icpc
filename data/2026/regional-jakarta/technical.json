{
  "ccs": {
    "primary": {
      "name": "DOMjudge",
      "version": ""
    }
  },
  "compilers": {
    "c": {
      "name": "C",
      "version": "gcc 14.2",
      "compileOpts": "gcc -x c -std=gnu23 -Wall -O2 -static -pipe -DONLINE_JUDGE -DDOMJUDGE -o \"$DEST\" \"$@\" -lm",
      "runOpts": "\"$DEST\" < infile > outfile"
    },
    "cpp": {
      "name": "C++",
      "version": "g++ 14.2",
      "compileOpts": "g++ -x c++ -std=gnu++23 -Wall -O2 -static -pipe -DONLINE_JUDGE -DDOMJUDGE -o \"$DEST\" \"$@\"",
      "runOpts": "\"$DEST\" < infile > outfile"
    },
    "java": {
      "name": "Java",
      "version": "openjdk 21.0.10",
      "compileOpts": "javac -encoding UTF-8 -sourcepath . -d . \"$@\"",
      "runOpts": "java -Dfile.encoding=UTF-8 -DONLINE_JUDGE -DDOMJUDGE -XX:+UseSerialGC -Xss${MEMSTACK}k -Xms${MEMLIMIT}k -Xmx${MEMLIMIT}k '$MAINCLASS' \"$@\" < infile > outfile"
    },
    "py3": {
      "name": "Python 3",
      "version": "PyPy 7.3.15 (python 3.9.18)",
      "compileOpts": "pypy3 -m py_compile \"$@\"",
      "runOpts": "pypy3 \"$@\" < infile > outfile"
    },
    "kotlin": {
      "name": "Kotlin",
      "version": "kotlin 1.7.21",
      "compileOpts": "kotlinc -d . -Djava.io.tmpdir=/ \"$@\"",
      "runOpts": "kotlin -Dfile.encoding=UTF-8 -J-DONLINE_JUDGE -J-DDOMJUDGE -J-XX:+UseSerialGC -J-Xss${MEMSTACK}k -J-Xms${MEMLIMIT}k -J-Xmx${MEMLIMIT}k '$MAINCLASS' \"$@\" < infile > outfile"
    }
  }
}
